<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        <%= mode==="update" ? "Update Product" : mode==="create" ? "Create Product" : "Product Management" %>
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <%- include("../partials/navbar") %>

        <%- include("../partials/alerts") %>


            <main class="container py-5">

                <div class="row justify-content-center">

                    <div class="col-lg-9">


                        <!-- ================================================= -->
                        <!-- HEADER -->
                        <!-- ================================================= -->

                        <div class="mb-4">

                            <span class="text-primary fw-semibold">
                                ADMIN
                            </span>

                            <h1 class="fw-bold">

                                <%= mode==="update" ? "Update Product" : mode==="create" ? "Create Product"
                                    : "Product Management" %>

                            </h1>

                            <p class="text-body-secondary">
                                Manage your product information.
                            </p>

                        </div>


                        <!-- ================================================= -->
                        <!-- PRODUCT FORM -->
                        <!-- ================================================= -->

                        <div class="dashboard-card">

                            <form method="POST" action="/ui" enctype="multipart/form-data">


                                <!-- ACTION -->

                                <input type="hidden" name="action" value="<%= mode === 'update'
                                ? 'update-product'
                                : 'create-product' %>">


                                <!-- PRODUCT ID -->

                                <% if (mode==="update" && product) { %>

                                    <input type="hidden" name="id" value="<%= product.id %>">

                                    <% } %>


                                        <!-- ================================================= -->
                                        <!-- NORMALIZE CURRENT IMAGE -->
                                        <!-- ================================================= -->

                                        <% let currentImage=null; if (product && product.image) { if (typeof
                                            product.image==="string" ) { try { currentImage=JSON.parse(product.image); }
                                            catch (error) { currentImage=null; } } else { currentImage=product.image; }
                                            } %>


                                            <!-- ================================================= -->
                                            <!-- CURRENT IMAGE -->
                                            <!-- ================================================= -->

                                            <% if ( mode==="update" && currentImage && currentImage.url ) { %>

                                                <div class="text-center mb-4">

                                                    <img src="<%= currentImage.url %>" alt="<%= product.name %>"
                                                        class="rounded shadow-sm" style="
                                        width:180px;
                                        height:180px;
                                        object-fit:cover;
                                    ">

                                                    <p class="text-body-secondary mt-2 mb-0">
                                                        Current Product Image
                                                    </p>

                                                </div>

                                                <% } %>


                                                    <!-- ================================================= -->
                                                    <!-- PRODUCT NAME -->
                                                    <!-- ================================================= -->

                                                    <div class="mb-3">

                                                        <label class="form-label">
                                                            Product Name
                                                        </label>

                                                        <input type="text" name="name" class="form-control"
                                                            value="<%= product ? product.name : '' %>"
                                                            placeholder="Enter product name" required>

                                                    </div>


                                                    <!-- ================================================= -->
                                                    <!-- CATEGORY -->
                                                    <!-- ================================================= -->

                                                    <div class="mb-3">

                                                        <label class="form-label">
                                                            Category
                                                        </label>

                                                        <input type="text" name="category" class="form-control"
                                                            value="<%= product ? product.category : '' %>"
                                                            placeholder="Enter category" required>

                                                    </div>


                                                    <!-- ================================================= -->
                                                    <!-- PRICE + STOCK -->
                                                    <!-- ================================================= -->

                                                    <div class="row">

                                                        <div class="col-md-6 mb-3">

                                                            <label class="form-label">
                                                                Price
                                                            </label>

                                                            <input type="number" name="price" class="form-control"
                                                                value="<%= product ? product.price : '' %>" min="0"
                                                                step="0.01" placeholder="0.00" required>

                                                        </div>


                                                        <div class="col-md-6 mb-3">

                                                            <label class="form-label">
                                                                Stock
                                                            </label>

                                                            <input type="number" name="stock" class="form-control"
                                                                value="<%= product ? product.stock : '' %>" min="0"
                                                                placeholder="0" required>

                                                        </div>

                                                    </div>


                                                    <!-- ================================================= -->
                                                    <!-- PRODUCT IMAGE -->
                                                    <!-- ================================================= -->

                                                    <div class="mb-4">

                                                        <label class="form-label">
                                                            Product Image
                                                        </label>

                                                        <input type="file" name="image" class="form-control"
                                                            accept="image/*">


                                                        <% if (mode==="update" ) { %>

                                                            <small class="text-body-secondary">

                                                                Leave empty to keep the current image.

                                                            </small>

                                                            <% } else { %>

                                                                <small class="text-body-secondary">

                                                                    Upload a product image.

                                                                </small>

                                                                <% } %>

                                                    </div>


                                                    <!-- ================================================= -->
                                                    <!-- BUTTONS -->
                                                    <!-- ================================================= -->

                                                    <div class="d-flex gap-2">

                                                        <a href="/ui?action=admin-products"
                                                            class="btn btn-outline-secondary flex-fill">
                                                            Cancel
                                                        </a>


                                                        <button type="submit" class="btn btn-primary flex-fill">

                                                            <%= mode==="update" ? "Update Product" : "Create Product" %>

                                                        </button>

                                                    </div>


                            </form>

                        </div>


                        <!-- ================================================= -->
                        <!-- PRODUCT LIST -->
                        <!-- ================================================= -->

                        <% if (mode==="create" && products) { %>

                            <div class="mt-5">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                                    <h3 class="fw-bold">
                                        Product List
                                    </h3>

                                    <span class="text-body-secondary">
                                        <%= products.length %> products
                                    </span>

                                </div>


                                <div class="table-responsive">

                                    <table class="table align-middle">

                                        <thead>

                                            <tr>

                                                <th>ID</th>

                                                <th>Image</th>

                                                <th>Product</th>

                                                <th>Category</th>

                                                <th>Price</th>

                                                <th>Stock</th>

                                                <th>Status</th>

                                                <th class="text-end">
                                                    Actions
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>

                                            <% if (products.length> 0) { %>

                                                <% products.forEach(product=> { %>


                                                    <!-- ================================================= -->
                                                    <!-- NORMALIZE PRODUCT IMAGE -->
                                                    <!-- ================================================= -->

                                                    <% let productImage=null; if (product.image) { if (typeof
                                                        product.image==="string" ) { try {
                                                        productImage=JSON.parse(product.image); } catch (error) {
                                                        productImage=null; } } else { productImage=product.image; } } %>


                                                        <tr>


                                                            <!-- ID -->

                                                            <td>
                                                                #<%= product.id %>
                                                            </td>


                                                            <!-- IMAGE -->

                                                            <td>

                                                                <% if ( productImage && productImage.url ) { %>

                                                                    <img src="<%= productImage.url %>"
                                                                        alt="<%= product.name %>" width="60" height="60"
                                                                        class="rounded shadow-sm" style="
                                                                object-fit:cover;
                                                                display:block;
                                                            ">

                                                                    <% } else { %>

                                                                        <div class="rounded d-flex align-items-center justify-content-center"
                                                                            style="
                                                                width:60px;
                                                                height:60px;
                                                                background:var(--bs-secondary-bg);
                                                                font-size:25px;
                                                            ">
                                                                            📦
                                                                        </div>

                                                                        <% } %>

                                                            </td>


                                                            <!-- NAME -->

                                                            <td>

                                                                <strong>
                                                                    <%= product.name %>
                                                                </strong>

                                                            </td>


                                                            <!-- CATEGORY -->

                                                            <td>

                                                                <span class="badge bg-secondary">

                                                                    <%= product.category %>

                                                                </span>

                                                            </td>


                                                            <!-- PRICE -->

                                                            <td>

                                                                ₹<%= Number(product.price).toFixed(2) %>

                                                            </td>


                                                            <!-- STOCK -->

                                                            <td>

                                                                <% if (product.stock> 0) { %>

                                                                    <span class="text-success">

                                                                        <%= product.stock %>

                                                                    </span>

                                                                    <% } else { %>

                                                                        <span class="text-danger">

                                                                            Out of stock

                                                                        </span>

                                                                        <% } %>

                                                            </td>


                                                            <!-- STATUS -->

                                                            <td>

                                                                <% if (product.isActive) { %>

                                                                    <span class="badge bg-success">
                                                                        Active
                                                                    </span>

                                                                    <% } else { %>

                                                                        <span class="badge bg-danger">
                                                                            Inactive
                                                                        </span>

                                                                        <% } %>

                                                            </td>


                                                            <!-- ACTIONS -->

                                                            <td class="text-end">

                                                                <div class="d-flex justify-content-end gap-2">


                                                                    <!-- UPDATE -->

                                                                    <a href="/ui?action=update-product-page&id=<%= product.id %>"
                                                                        class="btn btn-sm btn-outline-primary">
                                                                        Edit
                                                                    </a>


                                                                    <!-- DELETE -->

                                                                    <form method="POST" action="/ui"
                                                                        onsubmit="return confirm('Are you sure you want to delete this product?');">

                                                                        <input type="hidden" name="action"
                                                                            value="delete-product">

                                                                        <input type="hidden" name="id"
                                                                            value="<%= product.id %>">

                                                                        <button type="submit"
                                                                            class="btn btn-sm btn-outline-danger">
                                                                            Delete
                                                                        </button>

                                                                    </form>


                                                                </div>

                                                            </td>


                                                        </tr>


                                                        <% }) %>


                                                            <% } else { %>


                                                                <tr>

                                                                    <td colspan="8" class="text-center py-5">

                                                                        <h5>
                                                                            No products found
                                                                        </h5>

                                                                        <p class="text-body-secondary">
                                                                            Create your first product.
                                                                        </p>

                                                                    </td>

                                                                </tr>


                                                                <% } %>

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                            <% } %>


                    </div>

                </div>

            </main>


            <%- include("../partials/footer") %>


</body>

</html>