<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <%- include("../partials/navbar") %>

        <%- include("../partials/alerts") %>

            <main class="container py-5">

                <div class="mb-5">

                    <span class="text-primary fw-semibold">
                        ADMIN PANEL
                    </span>

                    <h1 class="fw-bold">
                        Business Dashboard
                    </h1>

                    <p class="text-secondary">
                        Monitor your store performance.
                    </p>

                </div>


                <div class="row g-4">

                    <div class="col-md-3">

                        <div class="dashboard-card">

                            <span>Total Orders</span>

                            <h2>
                                <%= dashboard.totalOrders %>
                            </h2>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="dashboard-card">

                            <span>Revenue</span>

                            <h2>
                                ₹<%= dashboard.revenue %>
                            </h2>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="dashboard-card">

                            <span>Average Order</span>

                            <h2>
                                ₹<%= dashboard.averageOrderValue %>
                            </h2>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="dashboard-card">

                            <span>Cancelled</span>

                            <h2>
                                <%= dashboard.cancelledOrders %>
                            </h2>

                        </div>

                    </div>

                </div>


                <div class="row mt-5 g-4">

                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body">

                                <h4>
                                    Category Sales
                                </h4>

                                <div class="table-responsive">

                                    <table class="table">

                                        <thead>
                                            <tr>
                                                <th>Category</th>
                                                <th>Quantity</th>
                                                <th>Revenue</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            <% categorySales.forEach(item=> { %>

                                                <tr>

                                                    <td>
                                                        <%= item.category %>
                                                    </td>

                                                    <td>
                                                        <%= item.totalQuantity %>
                                                    </td>

                                                    <td>
                                                        ₹<%= item.revenue %>
                                                    </td>

                                                </tr>

                                                <% }) %>

                                        </tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body">

                                <h4>
                                    Top Products
                                </h4>

                                <% topProducts.forEach(item=> { %>

                                    <div class="d-flex justify-content-between border-bottom py-3">

                                        <span>
                                            <%= item.name %>
                                        </span>

                                        <strong>
                                            ₹<%= item.revenue %>
                                        </strong>

                                    </div>

                                    <% }) %>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="mt-5">

                    <a href="/ui?action=admin-products" class="btn btn-primary">
                        Manage Products
                    </a>

                </div>

            </main>

            <%- include("../partials/footer") %>

</body>

</html>