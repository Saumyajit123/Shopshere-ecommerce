<!doctype html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Wishlist · ShopSphere</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>

<body><%- include("../partials/navbar") %><%- include("../partials/alerts") %>
            <main class="container py-5">
                <div class="page-heading"><span class="eyebrow">SAVED FOR LATER</span>
                    <h1>Your wishlist</h1>
                    <p>Keep your favourites close.</p>
                </div>
                <div class="row g-4">
                    <% if(!items.length){ %>
                        <div class="col-12">
                            <div class="surface-card empty-state">
                                <div class="empty-icon">♡</div>
                                <h3>No saved items yet</h3><a class="btn btn-dark rounded-pill px-4"
                                    href="/ui?action=products">Browse collection</a>
                            </div>
                        </div>
                        <% } items.forEach(entry=> { let p=entry.product; %><div class="col-sm-6 col-lg-4 col-xl-3">
                                <div class="product-card h-100"><a href="/ui?action=product-details&id=<%= p.id %>"
                                        class="product-image-wrapper d-block">
                                        <% if(p.image && p.image.url){ %><img class="product-card-image"
                                                src="<%= p.image.url %>" alt="<%= p.name %>">
                                            <% } else { %>
                                                <div class="product-image-placeholder"><span>✦</span>
                                                    <p>ShopSphere edit</p>
                                                </div>
                                                <% } %>
                                    </a>
                                    <div class="p-3">
                                        <h5>
                                            <%= p.name %>
                                        </h5>
                                        <p class="text-secondary small">
                                            <%= p.category %>
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center"><strong>₹<%=
                                                    Number(p.price).toFixed(2) %></strong>
                                            <form method="POST" action="/ui"><input type="hidden" name="action"
                                                    value="remove-wishlist"><input type="hidden" name="productId"
                                                    value="<%= p.id %>"><button
                                                    class="btn btn-outline-danger btn-sm rounded-pill">Remove</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                </div>
            </main><%- include("../partials/footer") %></body>

</html>