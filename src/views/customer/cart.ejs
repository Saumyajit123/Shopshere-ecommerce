<!doctype html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Your Cart · ShopSphere"></title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="/css/style.css" rel="stylesheet">
</head>

<body><%- include("../partials/navbar") %><%- include("../partials/alerts") %>
            <main class="container py-5">
                <div class="page-heading"><span class="eyebrow">YOUR BAG</span>
                    <h1>Shopping cart</h1>
                    <p>Review your items before you check out.</p>
                </div>
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="surface-card">
                            <% if (!cart.items.length) { %>
                                <div class="empty-state">
                                    <div class="empty-icon">🛍️</div>
                                    <h3>Your cart is waiting</h3>
                                    <p>Discover something you’ll love.</p><a class="btn btn-dark rounded-pill px-4"
                                        href="/ui?action=products">Explore products</a>
                                </div>
                                <% } else { cart.items.forEach(item=> { %>
                                    <div class="cart-line">
                                        <div class="cart-thumb">
                                            <% if(item.product && item.product.image && item.product.image.url){ %><img
                                                    src="<%= item.product.image.url %>" alt="">
                                                <% } else { %><span>✦</span>
                                                    <% } %>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h5>
                                                <%= item.product ? item.product.name : "Unavailable product" %>
                                            </h5>
                                            <p class="text-secondary small mb-2">
                                                <%= item.product ? item.product.category : "" %>
                                                    <% if(item.productVariant){ %> · <%= item.productVariant.name %>
                                                            <% } %>
                                            </p><strong>₹<%= Number(item.price).toFixed(2) %></strong>
                                            <form class="d-flex gap-2 mt-3" method="POST" action="/ui"><input
                                                    type="hidden" name="action" value="update-cart-item"><input
                                                    type="hidden" name="id" value="<%= item.id %>"><input
                                                    class="form-control quantity-input" type="number" min="1"
                                                    max="<%= item.productVariant ? item.productVariant.stock : item.product.stock %>"
                                                    name="quantity" value="<%= item.quantity %>"><button
                                                    class="btn btn-outline-dark btn-sm rounded-pill">Update</button>
                                            </form>
                                        </div>
                                        <div class="text-end"><strong>₹<%= item.subtotal.toFixed(2) %></strong>
                                            <form method="POST" action="/ui" class="mt-3"><input type="hidden"
                                                    name="action" value="remove-cart-item"><input type="hidden"
                                                    name="id" value="<%= item.id %>"><button
                                                    class="btn btn-link text-danger p-0 small">Remove</button></form>
                                        </div>
                                    </div>
                                    <% }) } %>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="surface-card summary-card">
                            <h4>Order summary</h4>
                            <div class="summary-row"><span>Subtotal</span><strong>₹<%= cart.subtotal.toFixed(2) %>
                                        </strong></div>
                            <div class="summary-row"><span>Shipping</span><span>
                                    <%= cart.subtotal>= 1500 || !cart.items.length ? "Free" : "₹99.00" %>
                                </span></div>
                            <hr>
                            <div class="summary-row total-row"><span>Estimated total</span><strong>₹<%= (cart.subtotal +
                                        (cart.subtotal>= 1500 || !cart.items.length ? 0 : 99)).toFixed(2) %></strong>
                            </div>
                            <% if(cart.items.length){ %><a href="/ui?action=addresses"
                                    class="btn btn-dark w-100 rounded-pill py-3 mt-3">Continue to checkout</a>
                                <% } %>
                                    <p class="text-secondary small mt-3 mb-0">Free shipping on orders over ₹1,500.</p>
                        </div>
                    </div>
                </div>
            </main><%- include("../partials/footer") %></body>

</html>