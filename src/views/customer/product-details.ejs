<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        <%= product.name %> | ShopSphere
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <%- include("../partials/navbar") %>

        <%- include("../partials/alerts") %>


            <main class="container py-5">


                <!-- ================================================= -->
                <!-- NORMALIZE PRODUCT IMAGE -->
                <!-- ================================================= -->

                <% let productImage=null; if (product && product.image) { if (typeof product.image==="string" ) { try {
                    productImage=JSON.parse(product.image); } catch (error) { productImage=null; } } else {
                    productImage=product.image; } } %>


                    <!-- ================================================= -->
                    <!-- BREADCRUMB -->
                    <!-- ================================================= -->

                    <nav aria-label="breadcrumb" class="mb-4">

                        <ol class="breadcrumb">

                            <li class="breadcrumb-item">

                                <a href="/ui?action=landing" class="text-decoration-none">
                                    Home
                                </a>

                            </li>


                            <li class="breadcrumb-item">

                                <a href="/ui?action=products" class="text-decoration-none">
                                    Products
                                </a>

                            </li>


                            <li class="breadcrumb-item active" aria-current="page">
                                <%= product.name %>
                            </li>

                        </ol>

                    </nav>


                    <!-- ================================================= -->
                    <!-- PRODUCT CARD -->
                    <!-- ================================================= -->

                    <div class="card border-0 shadow-sm overflow-hidden">

                        <div class="card-body p-0">

                            <div class="row g-0">


                                <!-- ================================================= -->
                                <!-- PRODUCT IMAGE -->
                                <!-- ================================================= -->

                                <div class="col-lg-6">

                                    <div
                                        class="p-4 p-lg-5 h-100 d-flex align-items-center justify-content-center bg-body-tertiary">


                                        <% if ( productImage && productImage.url ) { %>

                                            <img src="<%= productImage.url %>" alt="<%= product.name %>"
                                                class="img-fluid rounded detail-image">

                                            <% } else { %>


                                                <div
                                                    class="detail-image rounded bg-body-secondary d-flex flex-column align-items-center justify-content-center">

                                                    <div class="display-1 mb-3">
                                                        📦
                                                    </div>

                                                    <span class="text-body-secondary">
                                                        No Image Available
                                                    </span>

                                                </div>


                                                <% } %>


                                    </div>

                                </div>


                                <!-- ================================================= -->
                                <!-- PRODUCT INFORMATION -->
                                <!-- ================================================= -->

                                <div class="col-lg-6">

                                    <div class="p-4 p-lg-5">


                                        <!-- ================================================= -->
                                        <!-- CATEGORY -->
                                        <!-- ================================================= -->

                                        <span class="badge text-bg-secondary mb-3">

                                            <%= product.category %>

                                        </span>


                                        <!-- ================================================= -->
                                        <!-- PRODUCT NAME -->
                                        <!-- ================================================= -->

                                        <h1 class="fw-bold mb-3">

                                            <%= product.name %>

                                        </h1>


                                        <!-- ================================================= -->
                                        <!-- PRICE -->
                                        <!-- ================================================= -->

                                        <div class="mb-4">

                                            <span class="display-6 fw-bold text-primary">

                                                ₹<%= product.price %>

                                            </span>

                                        </div>


                                        <!-- ================================================= -->
                                        <!-- STOCK -->
                                        <!-- ================================================= -->

                                        <div class="mb-4">


                                            <% if (product.stock> 0) { %>

                                                <div class="d-flex align-items-center gap-2">

                                                    <span class="badge text-bg-success">
                                                        In Stock
                                                    </span>

                                                    <span class="text-body-secondary">

                                                        <%= product.stock %>
                                                            units available

                                                    </span>

                                                </div>


                                                <% } else { %>


                                                    <div class="d-flex align-items-center gap-2">

                                                        <span class="badge text-bg-danger">
                                                            Out of Stock
                                                        </span>

                                                        <span class="text-body-secondary">
                                                            Currently unavailable
                                                        </span>

                                                    </div>


                                                    <% } %>


                                        </div>


                                        <% if (currentUser && (product.stock > 0 || (product.variants && product.variants.some(v => v.stock > 0)))) { %>
                                        <div class="d-flex flex-wrap gap-2 mb-4">
                                            <form method="POST" action="/ui" class="d-flex flex-wrap gap-2">
                                                <input type="hidden" name="action" value="add-cart-item">
                                                <input type="hidden" name="productId" value="<%= product.id %>">
                                                <% if (product.variants && product.variants.length) { %>
                                                <select class="form-select" name="variantId" required style="max-width:220px">
                                                    <option value="">Choose a variant</option>
                                                    <% product.variants.forEach(v => { if (v.stock > 0) { %>
                                                    <option value="<%= v.id %>"><%= v.name %><%= v.color ? ' · ' + v.color : '' %><%= v.size ? ' · ' + v.size : '' %> — ₹<%= Number(v.price || product.price).toFixed(2) %> (<%= v.stock %> left)</option>
                                                    <% } }) %>
                                                </select>
                                                <% } %>
                                                <input type="number" class="form-control" name="quantity" value="1" min="1" style="width:90px">
                                                <button class="btn btn-dark rounded-pill px-4" type="submit">Add to cart</button>
                                            </form>
                                            <form method="POST" action="/ui">
                                                <input type="hidden" name="action" value="add-wishlist">
                                                <input type="hidden" name="productId" value="<%= product.id %>">
                                                <button class="btn btn-outline-secondary rounded-pill px-4" type="submit">♡ Save</button>
                                            </form>
                                        </div>
                                        <% } else if (!currentUser) { %>
                                        <a class="btn btn-dark rounded-pill px-4 mb-4" href="/ui?action=landing">Login to shop</a>
                                        <% } %>

                                        <hr>


                                        <!-- ================================================= -->
                                        <!-- DESCRIPTION -->
                                        <!-- ================================================= -->

                                        <div class="my-4">

                                            <h5 class="fw-bold">
                                                Product Information
                                            </h5>

                                            <p class="text-body-secondary">

                                                This is a high-quality

                                                <strong>
                                                    <%= product.category %>
                                                </strong>

                                                product available from our store.

                                                Shop with confidence and enjoy a
                                                reliable shopping experience.

                                            </p>

                                        </div>


                                        <!-- ================================================= -->
                                        <!-- PRODUCT META -->
                                        <!-- ================================================= -->

                                        <div class="row g-3 mb-4">


                                            <!-- PRODUCT ID -->

                                            <div class="col-6">

                                                <div class="p-3 rounded bg-body-tertiary">

                                                    <small class="text-body-secondary d-block">
                                                        Product ID
                                                    </small>

                                                    <strong>
                                                        #<%= product.id %>
                                                    </strong>

                                                </div>

                                            </div>


                                            <!-- CATEGORY -->

                                            <div class="col-6">

                                                <div class="p-3 rounded bg-body-tertiary">

                                                    <small class="text-body-secondary d-block">
                                                        Category
                                                    </small>

                                                    <strong>
                                                        <%= product.category %>
                                                    </strong>

                                                </div>

                                            </div>


                                        </div>


                                        <!-- ================================================= -->
                                        <!-- ORDER SECTION -->
                                        <!-- ================================================= -->

                                        <% if (product.stock> 0) { %>


                                            <% if (currentUser) { %>


                                                <% if ( currentUser.role==="user" || currentUser.role==="customer" ) {
                                                    %>


                                                    <!-- ================================================= -->
                                                    <!-- ORDER FORM -->
                                                    <!-- ================================================= -->

                                                    <form method="POST" action="/ui">

                                                        <input type="hidden" name="action" value="create-order">


                                                        <!-- ORDER ITEMS -->

                                                        <input type="hidden" name="items" id="orderItems" value="">


                                                        <div class="row g-3 align-items-end">


                                                            <!-- ================================================= -->
                                                            <!-- QUANTITY -->
                                                            <!-- ================================================= -->

                                                            <div class="col-sm-4">

                                                                <label class="form-label">
                                                                    Quantity
                                                                </label>

                                                                <input type="number" id="quantity" class="form-control"
                                                                    value="1" min="1" max="<%= product.stock %>"
                                                                    required>

                                                            </div>


                                                            <!-- ================================================= -->
                                                            <!-- BUY BUTTON -->
                                                            <!-- ================================================= -->

                                                            <div class="col-sm-8">

                                                                <button type="submit"
                                                                    class="btn btn-primary btn-lg w-100"
                                                                    onclick="prepareOrder(event)">
                                                                    Buy Now
                                                                </button>

                                                            </div>


                                                        </div>

                                                    </form>


                                                    <% } else { %>


                                                        <!-- ================================================= -->
                                                        <!-- ADMIN MESSAGE -->
                                                        <!-- ================================================= -->

                                                        <div class="alert alert-info">

                                                            Admin accounts cannot place
                                                            customer orders.

                                                        </div>


                                                        <% } %>


                                                            <% } else { %>


                                                                <!-- ================================================= -->
                                                                <!-- LOGIN REQUIRED -->
                                                                <!-- ================================================= -->

                                                                <div class="alert alert-light border">

                                                                    <div class="fw-semibold mb-1">
                                                                        Login required
                                                                    </div>

                                                                    <div class="text-body-secondary mb-3">
                                                                        Please login to purchase this product.
                                                                    </div>

                                                                    <button type="button" class="btn btn-primary"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#loginModal">
                                                                        Login to Continue
                                                                    </button>

                                                                </div>


                                                                <% } %>


                                                                    <% } else { %>


                                                                        <!-- ================================================= -->
                                                                        <!-- OUT OF STOCK -->
                                                                        <!-- ================================================= -->

                                                                        <button type="button"
                                                                            class="btn btn-secondary btn-lg w-100"
                                                                            disabled>
                                                                            Out of Stock
                                                                        </button>


                                                                        <% } %>


                                    </div>

                                </div>


                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- BACK BUTTON -->
                    <!-- ================================================= -->

                    <div class="mt-4">

                        <a href="/ui?action=products" class="btn btn-outline-secondary">
                            ← Back to Products
                        </a>

                    </div>


            </main>


            <!-- ===================================================== -->
            <!-- FOOTER -->
            <!-- ===================================================== -->

            <%- include("../partials/footer") %>


                <!-- ===================================================== -->
                <!-- ORDER SCRIPT -->
                <!-- ===================================================== -->

                <script>

                    function prepareOrder(event) {

                        event.preventDefault();


                        const quantity =
                            Number(
                                document.getElementById("quantity").value
                            );


                        const orderItems =
                            document.getElementById("orderItems");


                        if (
                            !quantity ||
                            quantity < 1
                        ) {

                            alert(
                                "Please enter a valid quantity."
                            );

                            return;

                        }


                        const maxStock =
                            Number("<%= product.stock %>");


                        if (quantity > maxStock) {

                            alert(
                                "Quantity cannot exceed available stock."
                            );

                            return;

                        }


                        const items = [

                            {
                                product: Number("<%= product.id %>"),
                                quantity: quantity
                            }

                        ];


                        orderItems.value =
                            JSON.stringify(items);


                        event.target
                            .closest("form")
                            .submit();

                    }

                </script>


</body>

</html>