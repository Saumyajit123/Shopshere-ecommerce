<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>My Orders | ShopSphere</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("../partials/navbar") %>

        <main class="container py-5">

            <span class="text-primary fw-semibold">ACCOUNT</span>

            <h1 class="fw-bold mb-2">My Orders</h1>

            <p class="text-body-secondary mb-4">
                Track your orders and view their details.
            </p>

            <% if (message) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= message %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <% } %>

                    <% if (error) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error %>
                        </div>
                        <% } %>

                            <% if (orders && orders.length> 0) { %>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-body-secondary">
                                        Showing <%= orders.length %> orders
                                            <% if (pagination) { %>
                                                of <%= pagination.totalItems %>
                                                    <% } %>
                                    </span>
                                </div>

                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Order ID</th>
                                                <th>Order Number</th>
                                                <th>Status</th>
                                                <th>Total</th>
                                                <th>Date</th>
                                                <th>Details</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <% orders.forEach(order=> { %>
                                                <tr>
                                                    <td>#<%= order.id %>
                                                    </td>

                                                    <td>
                                                        <%= order.orderNumber || "-" %>
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-primary">
                                                            <%= order.status || order.orderStatus || "Pending" %>
                                                        </span>
                                                    </td>

                                                    <td>
                                                        ₹<%= Number( order.finalAmount ?? order.totalAmount ?? 0
                                                            ).toFixed(2) %>
                                                    </td>

                                                    <td>
                                                        <%= order.createdAt ? new
                                                            Date(order.createdAt).toLocaleDateString() : "-" %>
                                                    </td>

                                                    <td>
                                                        <a href="/ui?action=order-details&id=<%= order.id %>"
                                                            class="btn btn-sm btn-outline-primary">
                                                            View Details
                                                        </a>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>

                                <% if (pagination && pagination.totalPages> 1) { %>

                                    <nav class="mt-4" aria-label="Orders pagination">

                                        <ul class="pagination justify-content-center flex-wrap">

                                            <li class="page-item
                            <%= pagination.hasPreviousPage ? '' : 'disabled' %>">

                                                <a class="page-link"
                                                    href="/ui?action=orders&page=<%= pagination.previousPage %>&limit=<%= pagination.limit %>"
                                                    <%=pagination.hasPreviousPage ? ''
                                                    : 'tabindex="-1" aria-disabled="true"' %>
                                                    >
                                                    Previous
                                                </a>
                                            </li>

                                            <% for (let p=1; p <=pagination.totalPages; p++) { %>

                                                <li class="page-item
                                <%= p === pagination.currentPage ? 'active' : '' %>">

                                                    <a class="page-link"
                                                        href="/ui?action=orders&page=<%= p %>&limit=<%= pagination.limit %>"
                                                        <%=p===pagination.currentPage ? 'aria-current="page"' : '' %>
                                                        >
                                                        <%= p %>
                                                    </a>
                                                </li>

                                                <% } %>

                                                    <li class="page-item
                            <%= pagination.hasNextPage ? '' : 'disabled' %>">

                                                        <a class="page-link"
                                                            href="/ui?action=orders&page=<%= pagination.nextPage %>&limit=<%= pagination.limit %>"
                                                            <%=pagination.hasNextPage ? ''
                                                            : 'tabindex="-1" aria-disabled="true"' %>
                                                            >
                                                            Next
                                                        </a>
                                                    </li>

                                        </ul>

                                        <p class="text-center text-body-secondary small">
                                            Page <%= pagination.currentPage %>
                                                of <%= pagination.totalPages %>
                                                    · <%= pagination.totalItems %> orders
                                        </p>

                                    </nav>

                                    <% } %>

                                        <% } else { %>

                                            <div class="text-center py-5">
                                                <h3>No orders yet</h3>

                                                <p class="text-body-secondary">
                                                    Your orders will appear here after checkout.
                                                </p>

                                                <a href="/ui?action=products" class="btn btn-primary">
                                                    Explore Products
                                                </a>
                                            </div>

                                            <% } %>

        </main>

        <%- include("../partials/footer") %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>