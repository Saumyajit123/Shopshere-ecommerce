<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>
        Products | ShopSphere
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>

    <%- include("../partials/navbar") %>

        <%- include("../partials/alerts") %>


            <main class="container py-5">


                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <div class="row align-items-center mb-4">

                    <div class="col-lg-7">

                        <span class="text-primary fw-semibold">
                            OUR STORE
                        </span>

                        <h1 class="fw-bold mt-2 mb-2">
                            Explore Products
                        </h1>

                        <p class="text-body-secondary mb-0">
                            Discover quality products at the best prices.
                        </p>

                    </div>


                    <div class="col-lg-5 mt-4 mt-lg-0">


                        <!-- ================================================= -->
                        <!-- SEARCH -->
                        <!-- ================================================= -->

                        <form method="GET" action="/ui">

                            <input type="hidden" name="action" value="products">

                            <div class="input-group">

                                <input type="search" name="name" class="form-control" placeholder="Search products..."
                                    value="<%= typeof query !== 'undefined' && query.name ? query.name : '' %>">

                                <button type="submit" class="btn btn-primary">
                                    Search
                                </button>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- FILTER CARD -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-body">

                        <form method="GET" action="/ui" class="row g-3 align-items-end">

                            <input type="hidden" name="action" value="products">


                            <!-- PRODUCT NAME -->

                            <div class="col-md-4">

                                <label class="form-label">
                                    Product Name
                                </label>

                                <input type="text" name="name" class="form-control" placeholder="Product name"
                                    value="<%= typeof query !== 'undefined' && query.name ? query.name : '' %>">

                            </div>


                            <!-- MIN PRICE -->

                            <div class="col-md-3">

                                <label class="form-label">
                                    Minimum Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input type="number" name="minprice" class="form-control" placeholder="0" min="0"
                                        step="0.01"
                                        value="<%= typeof query !== 'undefined' && query.minprice ? query.minprice : '' %>">

                                </div>

                            </div>


                            <!-- MAX PRICE -->

                            <div class="col-md-3">

                                <label class="form-label">
                                    Maximum Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input type="number" name="maxprice" class="form-control" placeholder="50000"
                                        min="0" step="0.01"
                                        value="<%= typeof query !== 'undefined' && query.maxprice ? query.maxprice : '' %>">

                                </div>

                            </div>


                            <!-- FILTER BUTTON -->

                            <div class="col-md-2">

                                <button type="submit" class="btn btn-primary w-100">
                                    Filter
                                </button>

                            </div>

                        </form>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PRODUCT COUNT -->
                <!-- ================================================= -->

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <% if ( pagination && pagination.totalproduct ) { %>

                            <span class="text-body-secondary">

                                Showing

                                <strong>
                                    <%= pagination.totalproduct %>
                                </strong>

                                products

                            </span>

                            <% } %>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PRODUCTS -->
                <!-- ================================================= -->

                <% if (products && products.length> 0) { %>

                    <div class="row g-4">


                        <% products.forEach(product=> { %>


                            <!-- ================================================= -->
                            <!-- NORMALIZE IMAGE -->
                            <!-- ================================================= -->

                            <% let productImage=null; if (product.image) { if (typeof product.image==="string" ) { try {
                                productImage=JSON.parse(product.image); } catch (error) { productImage=null; } } else {
                                productImage=product.image; } } %>


                                <div class="col-sm-6 col-lg-4 col-xl-3">

                                    <div class="product-card h-100">


                                        <!-- ================================================= -->
                                        <!-- PRODUCT IMAGE -->
                                        <!-- ================================================= -->

                                        <div class="product-image-wrapper position-relative">


                                            <% if ( productImage && productImage.url ) { %>

                                                <img src="<%= productImage.url %>" alt="<%= product.name %>"
                                                    class="product-card-image">

                                                <% } else { %>

                                                    <div class="product-image-placeholder">

                                                        <span>
                                                            📦
                                                        </span>

                                                        <p>
                                                            No Image
                                                        </p>

                                                    </div>

                                                    <% } %>


                                                        <!-- STOCK BADGE -->

                                                        <% if (product.stock> 0) { %>

                                                            <span
                                                                class="badge bg-success position-absolute top-0 end-0 m-3">
                                                                In Stock
                                                            </span>

                                                            <% } else { %>

                                                                <span
                                                                    class="badge bg-danger position-absolute top-0 end-0 m-3">
                                                                    Out of Stock
                                                                </span>

                                                                <% } %>


                                        </div>


                                        <!-- ================================================= -->
                                        <!-- PRODUCT INFORMATION -->
                                        <!-- ================================================= -->

                                        <div class="p-3">


                                            <!-- CATEGORY -->

                                            <span class="badge bg-secondary mb-2">

                                                <%= product.category %>

                                            </span>


                                            <!-- PRODUCT NAME -->

                                            <h4 class="fw-bold">

                                                <%= product.name %>

                                            </h4>


                                            <!-- PRICE + STOCK -->

                                            <div class="d-flex justify-content-between align-items-center mt-4">

                                                <h4 class="fw-bold mb-0">

                                                    ₹<%= Number(product.price).toFixed(2) %>

                                                </h4>


                                                <span class="text-success">

                                                    <%= product.stock %>
                                                        available

                                                </span>

                                            </div>


                                            <!-- DETAILS BUTTON -->

                                            <a href="/ui?action=product-details&id=<%= product.id %>"
                                                class="btn btn-primary w-100 mt-4">
                                                View Details
                                            </a>

                                            <% if (currentUser && product.stock > 0) { %>
                                            <div class="d-flex gap-2 mt-2">
                                                <form method="POST" action="/ui" class="flex-grow-1">
                                                    <input type="hidden" name="action" value="add-cart-item">
                                                    <input type="hidden" name="productId" value="<%= product.id %>">
                                                    <input type="hidden" name="quantity" value="1">
                                                    <button class="btn btn-dark w-100 rounded-pill" type="submit">Add to cart</button>
                                                </form>
                                                <form method="POST" action="/ui">
                                                    <input type="hidden" name="action" value="add-wishlist">
                                                    <input type="hidden" name="productId" value="<%= product.id %>">
                                                    <button class="btn btn-outline-secondary rounded-pill" title="Save to wishlist" type="submit">♡</button>
                                                </form>
                                            </div>
                                            <% } %>


                                        </div>


                                    </div>

                                </div>


                                <% }) %>


                    </div>


                    <% } else {%>


                        <!-- ================================================= -->
                        <!-- NO PRODUCTS -->
                        <!-- ================================================= -->

                        <div class="card border-0 shadow-sm">

                            <div class="card-body text-center py-5">

                                <div class="display-4 mb-3">
                                    📦
                                </div>

                                <h4 class="fw-bold">
                                    No Products Found
                                </h4>

                                <p class="text-body-secondary">
                                    Try changing your search or price filters.
                                </p>

                                <a href="/ui?action=products" class="btn btn-primary">
                                    View All Products
                                </a>

                            </div>

                        </div>


                        <% } %>


                            <!-- ================================================= -->
                            <!-- PAGINATION -->
                            <!-- ================================================= -->

                            <% if ( pagination && pagination.totalpage && pagination.totalpage> 1
                                ) { %>


                                <nav class="mt-5" aria-label="Product pagination">

                                    <ul class="pagination justify-content-center">


                                        <!-- ================================================= -->
                                        <!-- PREVIOUS -->
                                        <!-- ================================================= -->

                                        <li class="page-item
                        <%= pagination.currentpage <= 1
                            ? 'disabled'
                            : '' %>">

                                            <a class="page-link"
                                                href="/ui?action=products&page=<%= pagination.currentpage - 1 %>&limit=5<%= query && query.name ? '&name=' + encodeURIComponent(query.name) : '' %><%= query && query.minprice ? '&minprice=' + query.minprice : '' %><%= query && query.maxprice ? '&maxprice=' + query.maxprice : '' %>">
                                                Previous
                                            </a>

                                        </li>


                                        <!-- ================================================= -->
                                        <!-- PAGE NUMBERS -->
                                        <!-- ================================================= -->

                                        <% for ( let page=1; page <=pagination.totalpage; page++ ) { %>

                                            <li class="page-item
                            <%= pagination.currentpage === page
                                ? 'active'
                                : '' %>">

                                                <a class="page-link"
                                                    href="/ui?action=products&page=<%= page %>&limit=5<%= query && query.name ? '&name=' + encodeURIComponent(query.name) : '' %><%= query && query.minprice ? '&minprice=' + query.minprice : '' %><%= query && query.maxprice ? '&maxprice=' + query.maxprice : '' %>">

                                                    <%= page %>

                                                </a>

                                            </li>

                                            <% } %>


                                                <!-- ================================================= -->
                                                <!-- NEXT -->
                                                <!-- ================================================= -->

                                                <li class="page-item
                        <%= pagination.currentpage >= pagination.totalpage
                            ? 'disabled'
                            : '' %>">

                                                    <a class="page-link"
                                                        href="/ui?action=products&page=<%= pagination.currentpage + 1 %>&limit=5<%= query && query.name ? '&name=' + encodeURIComponent(query.name) : '' %><%= query && query.minprice ? '&minprice=' + query.minprice : '' %><%= query && query.maxprice ? '&maxprice=' + query.maxprice : '' %>">
                                                        Next
                                                    </a>

                                                </li>


                                    </ul>

                                </nav>


                                <% } %>


            </main>


            <%- include("../partials/footer") %>


</body>

</html>